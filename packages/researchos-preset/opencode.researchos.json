{
  "mcp": {
    "researchos-literature": {
      "type": "local",
      "command": ["uv", "run", "--project", "packages/researchos-mcp/literature", "python", "packages/researchos-mcp/literature/src/server.py"]
    },
    "researchos-data": {
      "type": "local",
      "command": ["uv", "run", "--directory", "packages/researchos-mcp/data", "researchos-data-mcp"]
    },
    "researchos-plot": {
      "type": "local",
      "command": ["uv", "run", "--directory", "packages/researchos-mcp/plot", "researchos-plot-mcp"]
    },
    "researchos-graph": {
      "type": "local",
      "command": ["bun", "run", "packages/researchos-graph/src/mcp.ts"]
    },
    "researchos-latex": {
      "type": "local",
      "command": ["bun", "run", "packages/researchos-latex/src/mcp.ts"]
    },
    "researchos-reproduce": {
      "type": "local",
      "command": ["bun", "run", "packages/researchos-reproduce/src/mcp.ts"]
    },
    "researchos-translate": {
      "type": "local",
      "command": ["uv", "run", "--project", "packages/researchos-mcp/translate", "python", "packages/researchos-mcp/translate/src/server.py"]
    }
  },
  "plugins": ["@researchos/writing", "@researchos/plot-core"],
  "agent": {
    "literature": { "file": "@researchos/preset/agent/literature.md", "color": "#61afef" },
    "graph": { "file": "@researchos/preset/agent/graph.md", "color": "#9d7cd8" },
    "paper-writer": { "file": "@researchos/preset/agent/paper-writer.md", "color": "#7fd88f" },
    "latex-editor": { "file": "@researchos/preset/agent/latex-editor.md", "color": "#a78bfa" },
    "data-analyst": { "file": "@researchos/preset/agent/data-analyst.md", "color": "#56b6c2" },
    "plot": { "file": "@researchos/preset/agent/plot.md", "color": "#EC4899" },
    "reproduce-doctor": { "file": "@researchos/preset/agent/reproduce-doctor.md", "color": "#f59e0b" },
    "translator": { "file": "@researchos/preset/agent/translator.md", "color": "#c678dd" }
  }
}
